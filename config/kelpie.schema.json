{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelpie.dev/schemas/project-v1.json",
  "title": "Kelpie project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "image": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memory_mb": { "type": "integer", "minimum": 1024 },
        "disk_gb": { "type": "integer", "minimum": 5 }
      }
    },
    "setup": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            ]
          }
        },
        "browser_paths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "health_path": { "type": "string", "pattern": "^/" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutes": { "type": "integer", "minimum": 15, "maximum": 1440 },
        "replans": { "type": "integer", "minimum": 0, "maximum": 20 },
        "cost": { "type": "string" }
      }
    },
    "secrets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
      "uniqueItems": true
    }
  }
}
