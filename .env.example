# Control plane
DATABASE_URL=postgresql+asyncpg://kelpie:kelpie@postgres:5432/kelpie
DATABASE_SCHEMA_MODE=validate
AUTH_MODE=development
DEVELOPMENT_SUBJECT=local-admin
DEVELOPMENT_ORGANIZATION=local
OIDC_ISSUER_URL=https://identity.example.com
OIDC_CLIENT_ID=kelpie-control
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
OIDC_REDIRECT_URI=https://control.example.com/auth/callback
OIDC_ORGANIZATION_CLAIM=organization
OIDC_SCOPES=openid,profile
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_SESSION_COOKIE_NAME=kelpie_session
OIDC_LOGIN_COOKIE_NAME=kelpie_oidc_state
OIDC_COOKIE_SECURE=true
OIDC_LOGIN_TTL_SECONDS=300
OIDC_SESSION_TTL_SECONDS=28800
OIDC_CLOCK_SKEW_SECONDS=30
WORKER_AUTH_MODE=scoped
# Shared credentials are accepted only with both auth modes explicitly set to development.
WORKER_SHARED_SECRET=
WORKER_SHARED_SECRET_FILE=
GATEWAY_SECRET=
GATEWAY_SECRET_FILE=
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_WEBHOOK_SECRET_FILE=
AGENT_TRIGGER_LABEL=agent-ready
CORS_ORIGINS=http://localhost:3000
SLACK_SIGNING_SECRET=
SLACK_SIGNING_SECRET_FILE=
SLACK_BOT_TOKEN=
SLACK_BOT_TOKEN_FILE=
SLACK_CHANNEL_ID=
# Deprecated and ignored for authorization; use config/iam.example.json Slack mappings.
SLACK_APPROVER_USER_IDS=
DASHBOARD_URL=http://localhost:3000
PREVIEW_DOMAIN=preview.example.com
PREVIEW_ALLOWED_CIDRS=10.240.0.0/16
ARTIFACT_ROOT=/var/lib/kelpie/artifacts
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
LOG_FORMAT=json
OTEL_SERVICE_NAME=kelpie-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Dashboard
KELPIE_API_URL=http://api:8000
NEXT_PUBLIC_KELPIE_API_URL=http://localhost:8000

# Worker daemon
KELPIE_CONTROL_URL=http://localhost:8000
# Required for libvirt: dedicated Guest-reachable HTTPS origin and pinned IPv4.
# libvirt 필수: Guest에서 접근할 전용 HTTPS Origin과 고정 IPv4.
KELPIE_GUEST_CONTROL_URL=
KELPIE_GUEST_CONTROL_IPV4=
# Optional private CA file on Worker (0600); never a private key.
# 선택적 Worker 사설 CA 파일(0600). 개인 키는 허용하지 않음.
KELPIE_GUEST_CONTROL_CA_FILE=
# Opt-in public IPv4 requires the root logging hook, public DNS and management CIDRs.
# 공개 IPv4 활성화에는 Root 기록 Hook, 공개 DNS와 관리 CIDR 설정이 필수.
KELPIE_GUEST_INTERNET=disabled
KELPIE_GUEST_DNS_IPV4=
KELPIE_GUEST_DENIED_IPV4=
KELPIE_NETWORK_POOL=10.240.0.0/16
# Provision with app.worker_admin; use a protected, reloadable token file.
KELPIE_WORKER_TOKEN=
KELPIE_WORKER_TOKEN_FILE=
KELPIE_WORKER_NAME=worker-1
KELPIE_EXECUTOR=mock
KELPIE_BASE_IMAGE=/var/lib/kelpie/images/ubuntu-desktop.qcow2
KELPIE_WORK_ROOT=/var/lib/kelpie/runs

# Preview gateway (development only until scoped OIDC preview grants are implemented)
KELPIE_GATEWAY_AUTH_MODE=disabled
KELPIE_GATEWAY_TOKEN=
